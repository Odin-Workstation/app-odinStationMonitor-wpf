<Window x:Class="TacoStationMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TacoStationMonitor.Controls"
        Title="Dashboard"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F3F5F7">

    <Grid>

        <!--================ ROWS ================-->
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!--================ HEADER ================-->
        <Border Grid.Row="0"
                Background="#3C3F41">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/Images/Odin-Workstation-Logo_white-text-55px.png"
                       Height="45"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Stretch="Uniform" />

                <!--<TextBlock Text="ODIN WORKSTATION"
                           VerticalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>-->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <!--<TextBlock Text="{Binding Station}"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>-->

                    <TextBlock Text="{Binding CurrentTime}"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="White" />

                </StackPanel>

            </Grid>

        </Border>

        <!--================ BODY ================-->

        <Grid Grid.Row="1"
              Margin="25,25,25,25">

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <controls:DashboardCard Margin="10"
                                    Title="Current Sequence Number"
                                    Value="{Binding Dashboard.PartID}" />

            <controls:DashboardCard Grid.Column="1"
                                    Margin="10"
                                    Title="Next Sequence Number"
                                    Value="{Binding Dashboard.NextPartID}" />

            <controls:DashboardCard Grid.Row="1"
                                    Margin="10"
                                    Title="Child Part Number"
                                    Value="{Binding Dashboard.ChildPartNo}" />

            <controls:DashboardCard Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10"
                                    Title="Status"
                                    Value="{Binding Dashboard.StatusString}" />

            <controls:DashboardCard Grid.Row="2"
                                    Margin="10"
                                    Title="MAT Number"
                                    Value="{Binding Dashboard.MatNo}" />

            <controls:DashboardCard Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="10"
                                    Title="Station Number"
                                    Value="{Binding Dashboard.Station}" />

        </Grid>

        <!--================ FOOTER ================-->

        <!--<Border Grid.Row="2"
                Background="#3C3F41" Margin="0,10,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                -->
        <!--<TextBlock Text="PLC : Connected"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"/>

                <TextBlock Grid.Column="1"
                           Text="Scanner : Ready"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"/>-->
        <!--

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentTime}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"/>

            </Grid>

        </Border>-->

    </Grid>

</Window>